{
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ES2022",
        "moduleResolution": "node",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "rootDir": ".",
        "baseUrl": ".",
        "strict": true,
        "types": ["jest"],
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules", "tmp"
    ]
}